# Copy to .env (gitignored) and adjust. docker-compose.yml reads these for its mounts and
# build, and also passes every variable here into the container's environment.

# Your host user's ids (`id -u`, `id -g`), so the container user owns mounted files.
# Changing them needs a rebuild: docker compose up -d --build
USER_UID=1000
USER_GID=1000

# Claude Code's config dir to mount at /home/dev/.claude. Your host one shares settings,
# CLAUDE.md, agents and sessions; point it at a separate dir (e.g. ~/.claude-devcontainer)
# to keep the container's Claude config apart.
CLAUDE_DIR=~/.claude

# Host dirs mounted into the container (ssh is read-only)
SSH_DIR=~/.ssh
KUBE_DIR=~/.kube
AWS_DIR=~/.aws
GH_CONFIG_DIR=~/.config/gh
GCLOUD_DIR=~/.config/gcloud

# Passed into the container. On macOS gh keeps its token in the keychain, so set GH_TOKEN.
# ANTHROPIC_API_KEY=
# GH_TOKEN=
